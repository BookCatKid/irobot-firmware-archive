    "firmware_request": {
      "source_class": "com.irobot.irobotdata.robot.internal.firmware.FirmwareRequest",
      "path": "/v2/firmware",
      "production_host": "content-prod.iot.irobotapi.com",
      "domain": "Domain.ContentStack / ContentStackHost",
      "required_query_parameters": [
        "sku",
        "softwareVer"
      ],
      "optional_query_parameters": [
        "track",
        "dockFwVer",
        "dockFwVerSec",
        "dockHwRev"
      ],
      "response_shape": {
        "firmware": "downloadable robot firmware item array",
        "dock": "dock update recommendation metadata only (version, provisioningPriority, otaPriority, track, expectedInstallationTime); no download URL in the 3.1.0 DTO"
      },
      "authentication": "ContentStackHost implements UnauthenticatedAPIHost. FirmwareRequest uses the default empty injectionSites list. Although FirmwareRepository receives AuthHTTPClient, BaseHttpWrapper resolves this request to ContentStackHost and IRobotHttpManager only SigV4-signs AuthenticatedAPIHost requests; therefore the production firmware fetch is not account-signed.",
      "evidence_files": [
        "FirmwareRequest.java",
        "ContentStackHost.java",
        "EnvironmentResolvable.java",
        "BaseHttpWrapper.java",
        "IRobotHttpManager.java",
        "DockFirmwareDto.java"
      ]
    },
